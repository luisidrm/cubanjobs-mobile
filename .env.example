# Where the app finds the API. Must start with EXPO_PUBLIC_ or Expo will not embed it.
# On a physical phone use your computer's LAN address (http://192.168.x.x:5000), not localhost.
# Release builds set this per profile in eas.json instead.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Error reporting (optional). Leave empty to turn it off.
EXPO_PUBLIC_SENTRY_DSN=
